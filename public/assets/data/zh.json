  "competitions_list": [
    {
      "title": "ICCAD 2025 CAD Contest — Problem C",
      "time": "2025/03–2025/09",
      "desc": [
        "國際級 EDA 研究競賽（NVIDIA 出題），聚焦於 Gate Sizing、Buffering 與 Cell Relocation 的增量式實體設計優化。",
        "負責演算法設計與程式實作，提升 PPA（Power, Performance, Area）品質。",
        "Beta submission 在 50% 測資中排名前三。",
        "Final submission 所有測資皆成功通過，完整達成設計合法性與效能提升要求。"
      ],
      "skills": [
        "EDA",
        "Placement",
        "Gate Sizing",
        "Buffer Insertion",
        "Optimization"
      ]
    },
    {
